# MPLADS Sentinel — environment configuration
# Copy to `.env` and adjust. Every variable has a working demo default;
# nothing here is required for `docker compose up` out of the box.

# ── Database (compose service `db`) ─────────────────────────────────
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel
POSTGRES_DB=sentinel
POSTGRES_PORT=5432

# ── Backend (compose service `backend`) ─────────────────────────────
# SQLAlchemy URL. Compose builds this from the POSTGRES_* values above.
# Local non-Docker backend runs default to backend/sentinel.db (SQLite).
# DATABASE_URL=postgresql+psycopg://sentinel:sentinel@db:5432/sentinel
BACKEND_PORT=8000

# Token required by all state-mutating endpoints (demo-grade auth — the
# decision surfaces show an explicit "demo bypass mode" label). Replace
# for any shared deployment.
DEMO_AUTH_TOKEN=sentinel-demo-2026

# JSON list of allowed browser origins (CORS). main.py reads this env var.
# Add your deployed frontend origin when hosting publicly.
# CORS_ORIGINS='["http://localhost:3000","http://127.0.0.1:3000"]'

# ── Frontend (compose service `web`) ────────────────────────────────
# Inlined into the client bundle at BUILD time — set before building the
# web image, and rebuild the image after changing these.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_DEMO_AUTH_TOKEN=sentinel-demo-2026
WEB_PORT=3000

# ── Notes ────────────────────────────────────────────────────────────
# • No secrets are hardcoded in the repo: the values above are public demo
#   placeholders, also set as code defaults. For a real deployment, change
#   POSTGRES_PASSWORD and DEMO_AUTH_TOKEN in your own `.env` (git-ignored)
#   and replace the demo-token module with real identity (NIC SSO/OAuth2).
# • `NEXT_PUBLIC_*` variables are visible to every browser user by design;
#   they are not a security boundary.
